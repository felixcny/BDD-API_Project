# ============================================================
# Configuration Oracle / Docker
# ============================================================

# Connexion locale à Oracle quand FastAPI tourne directement sur Windows
DATABASE_URL=oracle+oracledb://USER:PASSWORD@localhost:1521/?service_name=FREEPDB1

# Mot de passe administrateur du conteneur Oracle Docker
ORACLE_PWD=CHANGE_ME

# Mot de passe de l'utilisateur applicatif gym_app
GYM_DB_PASSWORD=CHANGE_ME

# ============================================================
# Authentification JWT
# ============================================================

# Clé utilisée pour signer les tokens JWT
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Algorithme utilisé pour les JWT
ALGORITHM=HS256

# Durée de validité d'un token en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60